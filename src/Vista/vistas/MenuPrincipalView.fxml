<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Vista.controladores.MenuPrincipalController"
            stylesheets="@../estilo/estilos.css">

    <left>
        <VBox styleClass="menu-lateral" prefWidth="205" spacing="5">
            <padding>
                <Insets top="16" right="14" bottom="16" left="14"/>
            </padding>
            <Label text="REPRODUCTOR" styleClass="titulo-menu"/>
            <Label fx:id="lblUsuario" wrapText="true"/>
            <Label fx:id="lblRol" styleClass="texto-secundario" wrapText="true"/>
            <Separator/>
            <Button text="Inicio" onAction="#inicio" maxWidth="Infinity"/>
            <Button text="Canciones" onAction="#canciones" maxWidth="Infinity"/>
            <Button text="Artistas" onAction="#artistas" maxWidth="Infinity"/>
            <Button text="Albumes" onAction="#albumes" maxWidth="Infinity"/>
            <Button text="Playlists" onAction="#playlists" maxWidth="Infinity"/>
            <Button fx:id="btnFavoritos" text="Mis favoritos" onAction="#favoritos" maxWidth="Infinity"/>
            <Button text="Mi perfil" onAction="#perfil" maxWidth="Infinity"/>
            <Separator/>
            <Button fx:id="btnUsuarios" text="Usuarios" onAction="#usuarios" maxWidth="Infinity"/>
            <Button fx:id="btnAcciones" text="Registro de acciones" onAction="#acciones" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesion" onAction="#cerrarSesion" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenido"/>
    </center>

    <bottom>
        <fx:include fx:id="barraReproductor" source="ReproductorBar.fxml"/>
    </bottom>
</BorderPane>
